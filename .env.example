# Anchor API (web/, Cloud Run): copy to .env and fill in. .env is gitignored; never commit a key.
# The deploy uploads .env as the repo's DOTENV secret (gh secret set DOTENV < .env).

# Inference gateway (OpenAI-compatible). API_KEY: this project's own key from the AI Lodge key bot.
API_BASE_URL=https://api.apiyi.com/v1
API_KEY=
# Every chat call: rewrite follow-ups, route, answer, check support, check numbers.
MODEL_NAME=deepseek-v4-1-flash-260910
# Offline diagram/figure descriptions only (scripts/describe_*.py): needs a vision model (deepseek-v4-1-flash-260910 reads images).
VISION_MODEL_NAME=deepseek-v4-1-flash-260910
# Embeddings for search; always requested at 768 dims (the pgvector column).
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Neon Postgres with pgvector, e.g. postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Load the sample Library once: python scripts/load_demo_library.py (with DATABASE_URL and API_KEY set).
DATABASE_URL=

# The Vercel site's origin(s), comma-separated (vercel-setup.sh sets the real one).
CORS_ORIGINS=http://localhost:5173

# Visitors' uploads are deleted this many hours after upload (cleanup runs on requests).
UPLOAD_TTL_HOURS=24

# Shared AI Lodge rate limiter: per-IP fallbacks when the central sheet has no row.
# The Upstash keys come from the batch's shared env, not this file.
RATE_LIMIT_ASK_MAX=5
RATE_LIMIT_UPLOAD_MAX=3
RATE_LIMIT_WINDOW_SECONDS=432000
